{
  "name": "richer-editor-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bizjs/richer-editor-playground dev",
    "build": "pnpm --filter @bizjs/richer-editor build && pnpm --filter @bizjs/richer-editor-playground build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:ssr": "pnpm --filter @bizjs/richer-editor test:ssr",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:ssr",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @bizjs/richer-editor build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.0"
  }
}
