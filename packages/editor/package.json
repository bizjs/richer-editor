{
  "name": "@bizjs/richer-editor",
  "version": "0.0.0",
  "description": "A modern, extensible rich-text editor for React, built on Tiptap.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ssr": "pnpm build && node --input-type=module --eval \"await import('@bizjs/richer-editor')\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tiptap/core": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "^0.22.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.1"
  }
}
